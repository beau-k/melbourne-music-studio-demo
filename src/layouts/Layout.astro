---
import '../styles/global.css';
import { site } from '../lib/site';

interface Props {
	title?: string;
}

const { title = `${site.name} | ${site.suburb} music lessons` } = Astro.props;

const navLinks = [
	{ href: '#lessons', label: 'Lessons' },
	{ href: '#teachers', label: 'Teachers' },
	{ href: '#schedule', label: 'Schedule' },
	{ href: '#faq', label: 'FAQ' },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Source+Sans+3:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content={`${site.name} — music lessons and rehearsal rooms in ${site.suburb}. Demo interactive lesson scheduler.`}
		/>
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-[#0f1412] font-sans text-stone-100 antialiased">
		<header class="sticky top-0 z-50 border-b border-white/10 bg-[#0f1412]/90 backdrop-blur-md">
			<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:h-[4.25rem] lg:px-8">
				<a href="#hero" class="font-display text-lg tracking-tight text-amber-200 sm:text-xl">{site.name}</a>
				<nav class="hidden items-center gap-7 text-sm font-medium text-stone-300 lg:flex" aria-label="Primary">
					{navLinks.map((link) => (
						<a class="transition hover:text-white" href={link.href}>
							{link.label}
						</a>
					))}
				</nav>
				<a
					href="#schedule"
					class="rounded-lg bg-amber-400 px-3.5 py-2 text-sm font-bold text-stone-950 transition hover:bg-amber-300"
				>
					Book a lesson
				</a>
			</div>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
